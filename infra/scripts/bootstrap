#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
COMPOSE_FILE="$REPO_ROOT/packages/adapters/src/lnd/docker-compose.smoke.yml"
LNCLI="$SCRIPT_DIR/lncli"
STATE_DIR="${TMPDIR:-/tmp}/boltwall-local-lnd-testing/$(printf '%s' "$REPO_ROOT" | cksum | cut -d ' ' -f 1)"
NODE_MAP_FILE="$STATE_DIR/nodes.env"

usage() {
  cat <<'EOF'
Usage:
  bun run bootstrap -- [--status] [--nodes <first>,<second>]
  bun run bootstrap -- [--status] [--nodes <first> <second>]

Starts the Boltwall local Bitcoin/LND regtest topology and waits until:
  - bitcoind answers regtest RPC calls
  - lnd-alice is initialized, unlocked, and reachable
  - lnd-bob is initialized, unlocked, and reachable

Use --nodes to assign logical test-node names while keeping the internal
two-service Docker topology. For example, --nodes carol,david makes later
bun run lncli -- carol ... and bun run lncli -- david ... commands work.

The LND containers use a deterministic dev-only wallet password through the
compose harness. Do not use this topology for production funds.
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

status_only=0
alice_alias=""
bob_alias=""

valid_alias() {
  case "$1" in
    "" | *[!A-Za-z0-9._-]*)
      return 1
      ;;
    *)
      [ "${#1}" -le 32 ]
      ;;
  esac
}

set_node_aliases() {
  first="$1"
  second="$2"

  if ! valid_alias "$first" || ! valid_alias "$second"; then
    echo "Node names must be 1-32 characters and use only letters, digits, dot, underscore, or dash." >&2
    exit 2
  fi

  if [ "$first" = "$second" ]; then
    echo "Node names must be distinct." >&2
    exit 2
  fi

  alice_alias="$first"
  bob_alias="$second"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --status)
      status_only=1
      shift
      ;;
    --nodes)
      shift
      if [ "${1:-}" = "" ]; then
        echo "--nodes requires <first>,<second> or <first> <second>." >&2
        exit 2
      fi
      if [ "${1#*,}" != "$1" ]; then
        first="${1%%,*}"
        second="${1#*,}"
        shift
      else
        first="$1"
        second="${2:-}"
        if [ -z "$second" ]; then
          echo "--nodes requires a second node name." >&2
          exit 2
        fi
        shift 2
      fi
      set_node_aliases "$first" "$second"
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

write_node_map() {
  mkdir -p "$STATE_DIR"
  {
    printf 'BOLTWALL_LND_ALICE_ALIAS=%s\n' "$alice_alias"
    printf 'BOLTWALL_LND_BOB_ALIAS=%s\n' "$bob_alias"
  } >"$NODE_MAP_FILE"
}

read_mapped_alias() {
  key="$1"
  if [ ! -f "$NODE_MAP_FILE" ]; then
    return 1
  fi
  awk -F= -v key="$key" '$1 == key { print $2; found = 1; exit } END { if (!found) exit 1 }' "$NODE_MAP_FILE"
}

if [ -z "$alice_alias" ] && [ -z "$bob_alias" ]; then
  alice_alias="$(read_mapped_alias BOLTWALL_LND_ALICE_ALIAS 2>/dev/null || true)"
  bob_alias="$(read_mapped_alias BOLTWALL_LND_BOB_ALIAS 2>/dev/null || true)"
fi

if [ -z "$alice_alias" ]; then
  alice_alias="alice"
fi

if [ -z "$bob_alias" ]; then
  bob_alias="bob"
fi

write_node_map
export BOLTWALL_LND_ALICE_ALIAS="$alice_alias"
export BOLTWALL_LND_BOB_ALIAS="$bob_alias"

if ! command -v docker >/dev/null 2>&1; then
  echo "docker is required but not found on PATH." >&2
  exit 1
fi

if ! docker compose version >/dev/null 2>&1; then
  echo "docker compose is required but unavailable." >&2
  exit 1
fi

if ! command -v curl >/dev/null 2>&1; then
  echo "curl is required but not found on PATH." >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "node is required for JSON handling but not found on PATH." >&2
  exit 1
fi

compose() {
  docker compose -f "$COMPOSE_FILE" "$@"
}

tail_logs() {
  service="$1"
  echo "Recent $service logs:" >&2
  compose logs --tail=80 "$service" >&2 || true
}

bitcoind_ready() {
  compose exec -T bitcoind bitcoin-cli \
    -regtest \
    -rpcuser=devuser \
    -rpcpassword=devpass \
    getblockchaininfo >/dev/null 2>&1
}

lnd_ready() {
  node="$1"
  "$LNCLI" "$node" getinfo >/dev/null 2>&1
}

lnd_rest_port() {
  case "$1" in
    alice)
      echo "8080"
      ;;
    bob)
      echo "8081"
      ;;
    *)
      echo "Unknown LND node '$1'." >&2
      return 2
      ;;
  esac
}

lnd_state() {
  node="$1"
  port="$(lnd_rest_port "$node")"
  curl -sk --fail "https://127.0.0.1:$port/v1/state" |
    node -e 'const fs = require("node:fs"); const state = JSON.parse(fs.readFileSync(0, "utf8")).state; if (!state) process.exit(1); process.stdout.write(state);'
}

lnd_rest_ready() {
  node="$1"
  lnd_state "$node" >/dev/null 2>&1
}

init_wallet() {
  node="$1"
  state="$(lnd_state "$node")"
  port="$(lnd_rest_port "$node")"
  password_base64="Ym9sdHdhbGwtcmVndGVzdC1kZXYtcGFzc3dvcmQ="

  case "$state" in
    SERVER_ACTIVE | RPC_ACTIVE | WAITING_TO_START)
      echo "lnd-$node wallet state is $state."
      return 0
      ;;
    NON_EXISTING)
      echo "Initializing lnd-$node dev wallet..."
      seed_json="$(curl -sk --fail "https://127.0.0.1:$port/v1/genseed")" || {
        echo "Failed to generate seed for lnd-$node." >&2
        tail_logs "lnd-$node"
        return 1
      }
      init_payload="$(
        printf '%s' "$seed_json" |
          WALLET_PASSWORD_BASE64="$password_base64" node -e 'const fs = require("node:fs"); const seed = JSON.parse(fs.readFileSync(0, "utf8")); process.stdout.write(JSON.stringify({ wallet_password: process.env.WALLET_PASSWORD_BASE64, cipher_seed_mnemonic: seed.cipher_seed_mnemonic }));'
      )"
      curl -sk --fail \
        -H "Content-Type: application/json" \
        --data "$init_payload" \
        "https://127.0.0.1:$port/v1/initwallet" >/dev/null || {
        echo "Failed to initialize lnd-$node wallet." >&2
        tail_logs "lnd-$node"
        return 1
      }
      return 0
      ;;
    LOCKED)
      echo "Unlocking lnd-$node dev wallet..."
      curl -sk --fail \
        -H "Content-Type: application/json" \
        --data "{\"wallet_password\":\"$password_base64\"}" \
        "https://127.0.0.1:$port/v1/unlockwallet" >/dev/null || {
        if wait_for "lnd-$node auto-unlock" 60 1 "lnd_ready $node" "lnd-$node"; then
          echo "lnd-$node wallet was already auto-unlocked."
          return 0
        fi
        echo "Failed to unlock lnd-$node wallet." >&2
        tail_logs "lnd-$node"
        return 1
      }
      return 0
      ;;
    *)
      echo "Unexpected lnd-$node wallet state: $state" >&2
      tail_logs "lnd-$node"
      return 1
      ;;
  esac
}

wait_for() {
  label="$1"
  attempts="$2"
  delay="$3"
  check="$4"
  service="$5"

  for i in $(seq 1 "$attempts"); do
    if $check; then
      echo "$label ready."
      return 0
    fi
    sleep "$delay"
  done

  echo "Timed out waiting for $label." >&2
  tail_logs "$service"
  return 1
}

node_alias_from_getinfo() {
  node="$1"
  "$LNCLI" "$node" getinfo |
    node -e 'const fs = require("node:fs"); const info = JSON.parse(fs.readFileSync(0, "utf8")); if (!info.alias) process.exit(1); process.stdout.write(info.alias);'
}

verify_alias() {
  node="$1"
  expected="$2"
  actual="$(node_alias_from_getinfo "$node")" || {
    echo "Could not read lnd-$node alias with lncli getinfo." >&2
    tail_logs "lnd-$node"
    return 1
  }

  if [ "$actual" != "$expected" ]; then
    echo "lnd-$node alias mismatch: expected '$expected', got '$actual'." >&2
    echo "Try running bun run bootstrap again; changing existing aliases may require container recreation." >&2
    tail_logs "lnd-$node"
    return 1
  fi

  printf '%s' "$actual"
}

if [ "$status_only" -eq 0 ]; then
  echo "Starting Boltwall regtest topology with logical nodes '$alice_alias' and '$bob_alias'..."
  if ! compose up -d; then
    echo "Docker Compose failed to start the regtest topology." >&2
    compose ps >&2 || true
    exit 1
  fi
fi

wait_for "bitcoind RPC" 120 1 bitcoind_ready bitcoind
wait_for "lnd-alice REST" 120 1 "lnd_rest_ready alice" lnd-alice
wait_for "lnd-bob REST" 120 1 "lnd_rest_ready bob" lnd-bob

init_wallet alice
init_wallet bob

wait_for "lnd-alice" 180 1 "lnd_ready alice" lnd-alice
wait_for "lnd-bob" 180 1 "lnd_ready bob" lnd-bob

alice_actual="$(verify_alias alice "$alice_alias")"
bob_actual="$(verify_alias bob "$bob_alias")"

cat <<EOF
Regtest Lightning bootstrap is ready.

Logical nodes:
  $alice_actual -> lnd-alice
  $bob_actual -> lnd-bob

Useful commands:
  bun run lncli -- $alice_actual getinfo
  bun run lncli -- $bob_actual getinfo
  bun run lncli -- $bob_actual walletbalance
  bun run lightning -- ready $alice_actual $bob_actual
EOF

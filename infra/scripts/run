#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'USAGE'
Usage:
  bun run infra -- <command> [args...]

Commands:
  bootstrap      Start or inspect the local Bitcoin/LND regtest topology
  lightning      Prepare channels, move payments, and inspect balances
  lncli          Run lncli against a regtest node by logical node name
  lnd-env        Print or export local LND adapter environment values
  smoke-adapter  Run the @boltwall/adapters LND payment smoke test

Examples:
  bun run infra -- bootstrap --nodes payer,server
  bun run infra -- lightning ready payer server
  bun run infra -- lncli payer walletbalance
  bun run infra -- lnd-env --node server --summary
  bun run infra -- smoke-adapter --payer payer --server server
USAGE
}

if [[ "${1:-}" == "" || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

command="$1"
shift

case "$command" in
  bootstrap | lightning | lncli | lnd-env | smoke-adapter)
    exec "$SCRIPT_DIR/$command" "$@"
    ;;
  *)
    echo "Unknown infra command: $command" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac

#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
COMPOSE_FILE="$REPO_ROOT/packages/adapters/src/lnd/docker-compose.smoke.yml"

usage() {
  cat <<'USAGE'
Usage:
  bun run infra -- teardown
  bun run infra -- teardown --reset --yes

Stops the local Bitcoin/LND regtest containers without removing Docker volumes,
wallets, channels, certs, macaroons, or regtest chain state.

Use --reset --yes only when you intentionally want to remove the local regtest
containers, network, and Docker volumes for a clean state. This deletes local
wallets, channels, certs, macaroons, and regtest chain state created by this
harness.
USAGE
}

reset_state=0
yes=0

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --reset)
      reset_state=1
      shift
      ;;
    --yes)
      yes=1
      shift
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
done

if [ "$reset_state" -eq 1 ] && [ "$yes" -ne 1 ]; then
  usage
  echo >&2
  echo "Refusing to reset local LND state without --yes." >&2
  echo "This operation removes Docker volumes containing wallets, channels, certs, macaroons, and regtest chain state." >&2
  exit 2
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "docker is required but not found on PATH." >&2
  exit 1
fi

if ! docker compose version >/dev/null 2>&1; then
  echo "docker compose is required but unavailable." >&2
  exit 1
fi

if [ "$reset_state" -eq 1 ]; then
  docker compose -f "$COMPOSE_FILE" down --volumes --remove-orphans
else
  docker compose -f "$COMPOSE_FILE" stop
fi

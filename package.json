{
  "name": "boltwall-suite",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "test:coverage": "turbo run test:coverage",
    "test:browser": "turbo run test:browser",
    "test:e2e": "turbo run test:e2e",
    "package-health": "turbo run package-health",
    "boltwall": "bun packages/proxy/src/cli.ts",
    "infra": "bash infra/scripts/run",
    "bootstrap": "bash infra/scripts/bootstrap",
    "lightning": "bash infra/scripts/lightning",
    "lncli": "bash infra/scripts/lncli",
    "lnd-env": "bash infra/scripts/lnd-env",
    "smoke-adapter": "bash infra/scripts/smoke-adapter",
    "playground": "turbo run dev --filter @boltwall/playground --env-mode=loose",
    "docs:api": "typedoc",
    "size": "turbo run size",
    "dev": "turbo run dev --parallel",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@changesets/cli": "^2.31.0",
    "eslint": "^9.39.1",
    "turbo": "^2.9.10",
    "typedoc": "^0.28.0",
    "typescript": "^6.0.3"
  }
}

{
  "name": "boltwall-suite",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": ["apps/*", "packages/*", "templates/*"],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:browser": "turbo run test:browser",
    "test:e2e": "turbo run test:e2e",
    "package-health": "turbo run package-health",
    "size": "turbo run size",
    "dev": "turbo run dev --parallel"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "turbo": "^2.9.10",
    "typescript": "^6.0.3"
  }
}

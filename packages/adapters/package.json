{
  "name": "@boltwall/adapters",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lnd": {
      "types": "./dist/lnd/index.d.ts",
      "import": "./dist/lnd/index.js"
    },
    "./voltage-lnd": {
      "types": "./dist/voltage-lnd/index.d.ts",
      "import": "./dist/voltage-lnd/index.js"
    },
    "./opennode": {
      "types": "./dist/opennode/index.d.ts",
      "import": "./dist/opennode/index.js"
    },
    "./btcpay": {
      "types": "./dist/btcpay/index.d.ts",
      "import": "./dist/btcpay/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/*.test.ts",
    "test:coverage": "bun test --coverage --coverage-reporter lcov test/*.test.ts",
    "test:browser": "playwright test --project=chromium",
    "test:integration": "bun test test/integration/*.test.ts",
    "package-health": "publint && sh -c 'tmp=${TMPDIR:-/tmp}/attw-$(basename \"$PWD\"); mkdir -p \"$tmp\"; bun pm pack --destination \"$tmp\" --ignore-scripts >/dev/null; node ../../node_modules/.bun/@arethetypeswrong+cli@0.18.2/node_modules/@arethetypeswrong/cli/dist/index.js \"$tmp/boltwall-$(basename \"$PWD\")-0.0.0.tgz\" --profile esm-only'"
  },
  "dependencies": {
    "@boltwall/internal": "workspace:*",
    "@boltwall/l402": "workspace:*"
  },
  "peerDependencies": {
    "lightning": "^11.1.0"
  },
  "peerDependenciesMeta": {
    "lightning": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@boltwall/eslint-config": "workspace:*",
    "@boltwall/prettier-config": "workspace:*",
    "@boltwall/typescript-config": "workspace:*",
    "@playwright/test": "^1.55.1",
    "lightning": "^11.1.0",
    "publint": "^0.3.15",
    "tsup": "^8.5.0"
  },
  "prettier": "@boltwall/prettier-config"
}

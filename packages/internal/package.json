{
  "name": "@boltwall/internal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./numeric": {
      "types": "./dist/numeric.d.ts",
      "import": "./dist/numeric.js"
    },
    "./header-grammar": {
      "types": "./dist/header-grammar.d.ts",
      "import": "./dist/header-grammar.js"
    }
  },
  "scripts": {
    "build": "bunx --bun tsup src/index.ts src/numeric.ts src/header-grammar.ts --format esm --clean --sourcemap && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@boltwall/eslint-config": "workspace:*",
    "@boltwall/prettier-config": "workspace:*",
    "@boltwall/typescript-config": "workspace:*",
    "tsup": "^8.5.0"
  },
  "prettier": "@boltwall/prettier-config"
}

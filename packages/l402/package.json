{
  "name": "@boltwall/l402",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/*.test.ts test/adversarial test/interop/aperture-smoke.test.ts",
    "test:browser": "playwright test --project=chromium-import",
    "test:interop": "APERTURE_INTEROP=1 APERTURE_URL=${APERTURE_URL:-http://localhost:8081} bun test test/interop/aperture-pr.test.ts",
    "package-health": "publint && sh -c 'tmp=${TMPDIR:-/tmp}/attw-$(basename \"$PWD\"); mkdir -p \"$tmp\"; bun pm pack --destination \"$tmp\" --ignore-scripts >/dev/null; node ../../node_modules/.bun/@arethetypeswrong+cli@0.18.2/node_modules/@arethetypeswrong/cli/dist/index.js \"$tmp/boltwall-$(basename \"$PWD\")-0.0.0.tgz\" --profile esm-only'",
    "size": "size-limit"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "light-bolt11-decoder": "^3.2.0",
    "macaroon": "3.0.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@boltwall/eslint-config": "workspace:*",
    "@boltwall/internal": "workspace:*",
    "@boltwall/prettier-config": "workspace:*",
    "@boltwall/test-fixtures": "workspace:*",
    "@boltwall/typescript-config": "workspace:*",
    "@playwright/test": "^1.55.1",
    "@size-limit/file": "11.2.0",
    "publint": "^0.3.15",
    "size-limit": "^11.2.0",
    "tsup": "^8.5.0"
  },
  "prettier": "@boltwall/prettier-config",
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "150 KB"
    }
  ]
}

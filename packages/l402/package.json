{
  "name": "@boltwall/l402",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wallet": {
      "types": "./dist/wallet/index.d.ts",
      "import": "./dist/wallet/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy/index.d.ts",
      "import": "./dist/legacy/index.js"
    },
    "./pricing": {
      "types": "./dist/pricing.d.ts",
      "import": "./dist/pricing.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/wallet/index.ts src/legacy/index.ts src/pricing.ts src/testing/index.ts --format esm --dts --clean --sourcemap",
    "lint": "bun x eslint src",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:browser": "playwright test --project=chromium-import",
    "package-health": "publint && sh -c 'tmp=/private/tmp/attw-$(basename \"$PWD\"); mkdir -p \"$tmp\"; bun pm pack --destination \"$tmp\" --ignore-scripts >/dev/null; node ../../node_modules/.bun/@arethetypeswrong+cli@0.18.2/node_modules/@arethetypeswrong/cli/dist/index.js \"$tmp/boltwall-$(basename \"$PWD\")-0.0.0.tgz\" --profile esm-only'",
    "size": "size-limit"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@boltwall/eslint-config": "workspace:*",
    "@boltwall/internal": "workspace:*",
    "@boltwall/prettier-config": "workspace:*",
    "@boltwall/test-fixtures": "workspace:*",
    "@boltwall/typescript-config": "workspace:*",
    "@playwright/test": "^1.55.1",
    "publint": "^0.3.15",
    "size-limit": "^11.2.0",
    "tsup": "^8.5.0"
  },
  "prettier": "@boltwall/prettier-config",
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "30 KB"
    }
  ]
}

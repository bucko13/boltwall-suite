{
  "name": "@boltwall/middleware",
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "import": "./dist/express/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts src/core/index.ts src/express/index.ts --format esm --dts --clean --sourcemap",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter lcov",
    "package-health": "publint && sh -c 'tmp=${TMPDIR:-/tmp}/attw-$(basename \"$PWD\"); mkdir -p \"$tmp\"; bun pm pack --destination \"$tmp\" --ignore-scripts >/dev/null; node ../../node_modules/.bun/@arethetypeswrong+cli@0.18.2/node_modules/@arethetypeswrong/cli/dist/index.js \"$tmp/boltwall-$(basename \"$PWD\")-0.0.0.tgz\" --profile esm-only'"
  },
  "dependencies": {
    "@boltwall/adapters": "workspace:*",
    "@boltwall/internal": "workspace:*",
    "@boltwall/l402": "workspace:*",
    "pino": "^10.3.1"
  },
  "peerDependencies": {
    "express": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@boltwall/eslint-config": "workspace:*",
    "@boltwall/prettier-config": "workspace:*",
    "@boltwall/test-fixtures": "workspace:*",
    "@boltwall/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "express": "^5.1.0",
    "express4": "npm:express@^4.21.2",
    "publint": "^0.3.15",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0"
  },
  "prettier": "@boltwall/prettier-config"
}

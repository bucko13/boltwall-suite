{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/core/index.ts", "src/express/index.ts"],
  "tsconfig": "tsconfig.json",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeExternals": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  }
}

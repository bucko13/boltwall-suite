{
  "name": "@boltwall/proxy",
  "version": "0.1.3",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "boltwall": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunx --bun tsup && tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/*.test.ts",
    "test:coverage": "bun test --coverage --coverage-reporter lcov test/*.test.ts",
    "package-health": "publint",
    "publish:npm": "bun publish --tolerate-republish"
  },
  "dependencies": {
    "@boltwall/adapters": "workspace:*",
    "@boltwall/l402": "workspace:*",
    "@boltwall/middleware": "workspace:*",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5",
    "yaml": "^2.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@boltwall/eslint-config": "workspace:*",
    "@boltwall/internal": "workspace:*",
    "@boltwall/prettier-config": "workspace:*",
    "@boltwall/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "publint": "^0.3.15",
    "tsup": "^8.5.0"
  },
  "prettier": "@boltwall/prettier-config"
}
